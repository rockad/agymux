#!/usr/bin/env bash
# agymux: Generic Antigravity Terminal Multiplexer with OpenCode-style tabs

set -euo pipefail

PROJECT=""
WORKDIR=""
SESSION_NAME=""
DIRECT=0

# Parse global flags
EXTRA_ARGS=()
while [[ $# -gt 0 ]]; do
    case "$1" in
        --project|-p)
            PROJECT="$2"
            shift 2
            ;;
        --dir|-C)
            WORKDIR="$2"
            shift 2
            ;;
        --session)
            SESSION_NAME="$2"
            shift 2
            ;;
        -d|--direct)
            DIRECT=1
            shift
            ;;
        -h|--help|help)
            cat <<'EOF'
Usage: agymux [options] [command] [args...]

Commands:
  attach [args...]      Attach to session (default) or run agy in current window
  switch, s             Open two-pane tab/conversation picker (fzf)
  project, P            Open global project switcher modal
  palette, pal          Open quick command palette modal
  helper, ?             Display keyboard shortcuts cheatsheet modal
  new, n [name] [args]  Open a new conversation tab
  run [args...]         Internal process runner with instant prompt-based naming
  preview <conv-id>     Render rich transcript preview (tokens, tools, prompt)
  ls, list              List active agymux sessions

Options:
  -p, --project <name>  Project name (default: directory basename)
  -C, --dir <path>      Working directory (default: current directory)
      --session <name>  Custom tmux session name (default: agy-<project>)
  -d, --direct          Direct execution without tmux (e.g. for agy help)
  -h, --help            Show this help message
EOF
            exit 0
            ;;
        *)
            EXTRA_ARGS+=("$1")
            shift
            ;;
    esac
done

SCRIPT_DIR="$(cd "$(dirname "$(readlink -f "${BASH_SOURCE[0]}")")" && pwd)"
LIB_DIR="${SCRIPT_DIR}/../lib"

WORKDIR="${WORKDIR:-${PWD}}"
PROJECT="${PROJECT:-${AGYMUX_PROJECT:-$(basename "$WORKDIR")}}}"
SESSION_NAME="${SESSION_NAME:-agy-${PROJECT}}"

# Escape hatch: direct execution without tmux
if [[ $DIRECT -eq 1 ]]; then
    exec agy --project "$PROJECT" "${EXTRA_ARGS[@]}"
fi

# Subcommand dispatch
CMD="${EXTRA_ARGS[0]:-attach}"
CMD_ARGS=()
if [[ ${#EXTRA_ARGS[@]} -gt 1 ]]; then
    CMD_ARGS=("${EXTRA_ARGS[@]:1}")
fi

has_tmux_client() {
    [[ -n "${TMUX:-}" ]] && [[ -n "$(tmux display-message -p '#{client_name}' 2>/dev/null || true)" ]]
}

case "$CMD" in
    # ------------------------------------------------------------- switch / s --
    switch|s)
        if [[ -f "${LIB_DIR}/ui/picker.sh" ]]; then
            picker_cmd="${LIB_DIR}/ui/picker.sh '${PROJECT}' '${WORKDIR}'"
        else
            echo "Error: picker.sh not found." >&2; exit 1
        fi

        if has_tmux_client; then
            tmux display-popup -E -w 85% -h 75% "$picker_cmd"
        else
            eval "$picker_cmd"
        fi
        ;;

    # ----------------------------------------------------------- project / P --
    project|P)
        if [[ -f "${LIB_DIR}/ui/project-picker.sh" ]]; then
            proj_cmd="${LIB_DIR}/ui/project-picker.sh"
        elif [[ -f "${LIB_DIR}/core/project.sh" ]]; then
            proj_cmd="${LIB_DIR}/core/project.sh list"
        else
            echo "Error: project-picker.sh not found." >&2; exit 1
        fi

        if has_tmux_client; then
            tmux display-popup -E -w 85% -h 70% "$proj_cmd"
        else
            eval "$proj_cmd"
        fi
        ;;

    # ----------------------------------------------------------- palette / p --
    palette|pal)
        if [[ -f "${LIB_DIR}/ui/palette.sh" ]]; then
            pal_cmd="${LIB_DIR}/ui/palette.sh ${CMD_ARGS[*]:-}"
        else
            echo "Error: palette.sh not found." >&2; exit 1
        fi

        if has_tmux_client; then
            tmux display-popup -E -w 75% -h 60% "$pal_cmd"
        else
            eval "$pal_cmd"
        fi
        ;;

    # ------------------------------------------------------------ helper / ? --
    helper|help-keys|cheatsheet)
        if [[ -f "${LIB_DIR}/ui/helper.sh" ]]; then
            help_cmd="${LIB_DIR}/ui/helper.sh"
        else
            echo "Error: helper.sh not found." >&2; exit 1
        fi

        if has_tmux_client; then
            tmux display-popup -E -w 75% -h 70% "$help_cmd"
        else
            eval "$help_cmd"
        fi
        ;;

    # --------------------------------------------------------------- preview --
    preview)
        if [[ -f "${LIB_DIR}/core/transcript.sh" ]]; then
            exec "${LIB_DIR}/core/transcript.sh" preview "${CMD_ARGS[@]}"
        else
            echo "Error: transcript.sh not found." >&2; exit 1
        fi
        ;;

    # ------------------------------------------------------------------ run --
    run|runner)
        if [[ -f "${LIB_DIR}/daemon/runner.sh" ]]; then
            exec "${LIB_DIR}/daemon/runner.sh" "${CMD_ARGS[@]}"
        else
            echo "Error: runner.sh not found." >&2; exit 1
        fi
        ;;

    # ---------------------------------------------------------------- new / n --
    new|n)
        tab_name="new-chat"
        tab_args=()
        if [[ ${#CMD_ARGS[@]} -gt 0 ]]; then
            if [[ "${CMD_ARGS[0]}" != -* ]]; then
                tab_name="${CMD_ARGS[0]}"
                tab_args=("${CMD_ARGS[@]:1}")
            else
                tab_args=("${CMD_ARGS[@]}")
            fi
        fi

        if [[ -n "${TMUX:-}" ]]; then
            tmux new-window -c "$WORKDIR" -n "$tab_name" \
                "agymux run --project '${PROJECT}' ${tab_args[*]:-}"
        else
            if ! tmux has-session -t "=${SESSION_NAME}" 2>/dev/null; then
                tmux new-session -s "${SESSION_NAME}" -c "$WORKDIR" -n "$tab_name" \
                    "agymux run --project '${PROJECT}' ${tab_args[*]:-}"
            else
                tmux new-window -t "=${SESSION_NAME}:" -c "$WORKDIR" -n "$tab_name" \
                    "agymux run --project '${PROJECT}' ${tab_args[*]:-}"
                tmux attach-session -t "=${SESSION_NAME}"
            fi
        fi
        ;;

    # -------------------------------------------------------------- ls / list --
    ls|list)
        active=$(tmux list-sessions -F "#{session_name} (#{?session_attached,attached,detached})" 2>/dev/null | grep "^agy-" || true)
        if [[ -z "$active" ]]; then
            echo "No active agymux sessions found."
        else
            echo "Active agymux sessions:"
            echo "$active"
        fi
        ;;

    # ----------------------------------------------------- attach / default --
    attach|*)
        # If inside tmux already: run agy directly to avoid nesting
        if [[ -n "${TMUX:-}" ]]; then
            if [[ "$CMD" == "attach" ]]; then
                exec "$0" run --project "$PROJECT" -c
            else
                exec "$0" run --project "$PROJECT" "$CMD" "${CMD_ARGS[@]}"
            fi
        fi

        # Outside tmux: attach to existing session or create it
        if tmux has-session -t "=${SESSION_NAME}" 2>/dev/null; then
            exec tmux attach-session -t "=${SESSION_NAME}"
        else
            if [[ "$CMD" == "attach" ]]; then
                exec tmux new-session -s "${SESSION_NAME}" -c "$WORKDIR" -n "main" \
                    "agymux run --project '${PROJECT}' -c"
            else
                exec tmux new-session -s "${SESSION_NAME}" -c "$WORKDIR" -n "main" \
                    "agymux run --project '${PROJECT}' '$CMD' ${CMD_ARGS[*]:-}"
            fi
        fi
        ;;
esac
