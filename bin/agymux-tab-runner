#!/usr/bin/env bash
# agymux-tab-runner: Process runner and dynamic title syncer for agymux tabs

set -euo pipefail

DB_PATH="${HOME}/.gemini/antigravity-cli/conversation_summaries.db"
PROJECT=""
CONV_ID=""
START_TIME=$(date -u +"%Y-%m-%d %H:%M:%S")

# Parse arguments
EXTRA_ARGS=()
while [[ $# -gt 0 ]]; do
    case "$1" in
        --project)
            PROJECT="$2"
            shift 2
            ;;
        --conversation)
            CONV_ID="$2"
            shift 2
            ;;
        *)
            EXTRA_ARGS+=("$1")
            shift
            ;;
    esac
done

PROJECT="${PROJECT:-${AGYMUX_PROJECT:-$(basename "$PWD")}}}"

# Sanitize title for tmux window name (max 18 chars)
sanitize_title() {
    local raw="$1"
    local clean="${raw//$'\n'/ }"
    clean="${clean//[^a-zA-Z0-9 _-]/}"
    clean="${clean:0:18}"
    echo "${clean:-agy}"
}

# 1. If inside tmux, initialize window metadata
if [[ -n "${TMUX:-}" ]]; then
    if [[ -n "$CONV_ID" ]]; then
        tmux set-option -w @conversation_id "$CONV_ID" 2>/dev/null || true
        # Look up existing title in database
        if [[ -f "$DB_PATH" ]] && command -v sqlite3 >/dev/null 2>&1; then
            existing_title=$(sqlite3 "$DB_PATH" "SELECT title FROM conversation_summaries WHERE conversation_id = '$CONV_ID' LIMIT 1;" 2>/dev/null || true)
            if [[ -n "$existing_title" ]]; then
                tmux rename-window "$(sanitize_title "$existing_title")" 2>/dev/null || true
            fi
        fi
    else
        tmux rename-window "+ new" 2>/dev/null || true
    fi
fi

# 2. Background watcher: For new conversations, automatically detect title assignment
SYNC_PID=""
if [[ -n "${TMUX:-}" && -z "$CONV_ID" && -f "$DB_PATH" ]] && command -v sqlite3 >/dev/null 2>&1; then
    (
        target_win=$(tmux display-message -p '#{window_id}' 2>/dev/null || echo "")
        [[ -z "$target_win" ]] && exit 0
        
        # Poll for 5 minutes maximum
        for _ in {1..75}; do
            sleep 4
            # Look for conversations updated since runner start
            found=$(sqlite3 "$DB_PATH" "
                SELECT conversation_id, title 
                FROM conversation_summaries 
                WHERE (workspace_uris LIKE '%${PROJECT}%' OR project_id = '${PROJECT}')
                  AND last_modified_time >= '${START_TIME}'
                  AND title IS NOT NULL AND title != ''
                ORDER BY last_modified_time DESC 
                LIMIT 1;
            " 2>/dev/null || true)

            if [[ -n "$found" ]]; then
                cid=$(echo "$found" | cut -d'|' -f1)
                ctitle=$(echo "$found" | cut -d'|' -f2)
                tmux set-option -w -t "$target_win" @conversation_id "$cid" 2>/dev/null || true
                tmux rename-window -t "$target_win" "$(sanitize_title "$ctitle")" 2>/dev/null || true
                break
            fi
        done
    ) &
    SYNC_PID=$!
fi

# Cleanup background watcher on exit
cleanup() {
    if [[ -n "$SYNC_PID" ]] && kill -0 "$SYNC_PID" 2>/dev/null; then
        kill "$SYNC_PID" 2>/dev/null || true
    fi
}
trap cleanup EXIT INT TERM

# 3. Assemble agy command
CMD=(agy --project "$PROJECT" --remote-control)
if [[ -n "$CONV_ID" ]]; then
    CMD+=(--conversation "$CONV_ID")
fi
if [[ ${#EXTRA_ARGS[@]} -gt 0 ]]; then
    CMD+=("${EXTRA_ARGS[@]}")
fi

# 4. Execute agy
set +e
"${CMD[@]}"
RET=$?
set -e

# 5. Handle exit status
if [[ $RET -ne 0 ]]; then
    echo ""
    echo "[agy exited with status $RET]"
    read -r -p "Press Enter to close window..." _ || true
fi

exit $RET
