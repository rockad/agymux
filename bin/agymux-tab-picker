#!/usr/bin/env bash
# agymux-tab-picker: Floating interactive conversation switcher for agymux
# Displays active tmux tabs and historical Antigravity conversations via fzf.

set -euo pipefail

SCRIPT_DIR="$(cd "$(dirname "$(readlink -f "${BASH_SOURCE[0]}")")" && pwd)"
if [[ -f "${SCRIPT_DIR}/../lib/ui/picker.sh" ]]; then
    exec "${SCRIPT_DIR}/../lib/ui/picker.sh" "$@"
fi

DB_PATH="${HOME}/.gemini/antigravity-cli/conversation_summaries.db"
PROJECT="${1:-${AGYMUX_PROJECT:-}}"
CURRENT_DIR="${2:-${PWD}}"

if [[ -z "$PROJECT" ]]; then
    # Try to extract project from active tmux session name (e.g. agy-doppelganger -> doppelganger)
    if [[ -n "${TMUX:-}" ]]; then
        sess_name=$(tmux display-message -p '#S' 2>/dev/null || echo "")
        if [[ "$sess_name" =~ ^agy-(.*)$ ]]; then
            PROJECT="${BASH_REMATCH[1]}"
        fi
    fi
    PROJECT="${PROJECT:-$(basename "$CURRENT_DIR")}"
fi

# 1. Fetch currently open tmux windows in the active session
declare -A OPEN_TABS_BY_CONV
declare -A OPEN_TABS_BY_INDEX

if [[ -n "${TMUX:-}" ]]; then
    while IFS=$'\t' read -r win_idx win_name conv_id win_active; do
        [[ -z "$win_idx" ]] && continue
        OPEN_TABS_BY_INDEX["$win_idx"]="$win_name"
        if [[ -n "$conv_id" ]]; then
            OPEN_TABS_BY_CONV["$conv_id"]="$win_idx"
        fi
    done < <(tmux list-windows -F "#{window_index}	#{window_name}	#{@conversation_id}	#{?window_active,*,}" 2>/dev/null || true)
fi

# 2. Build candidate list for fzf
# Temporary file to store tab and history mappings
MENU_ITEMS=$(mktemp)
DATA_MAP=$(mktemp)
trap 'rm -f "$MENU_ITEMS" "$DATA_MAP"' EXIT

# First entry: New tab
echo "➕ [New Conversation Tab]" >> "$MENU_ITEMS"
echo "NEW	__NEW__	New Chat" >> "$DATA_MAP"

# Open tabs in current tmux session
if [[ -n "${TMUX:-}" ]]; then
    while IFS=$'\t' read -r win_idx win_name conv_id win_active; do
        [[ -z "$win_idx" ]] && continue
        marker="  "
        [[ "$win_active" == "*" ]] && marker="▶ "
        display_line=$(printf "%s[Tab %s] %-30s (open)" "$marker" "$win_idx" "$win_name")
        echo "$display_line" >> "$MENU_ITEMS"
        echo "TAB	$win_idx	$win_name" >> "$DATA_MAP"
    done < <(tmux list-windows -F "#{window_index}	#{window_name}	#{@conversation_id}	#{?window_active,*,}" 2>/dev/null || true)
fi

# Historical conversations from SQLite database
if [[ -f "$DB_PATH" ]] && command -v sqlite3 >/dev/null 2>&1; then
    # Query matching conversations
    SQL_QUERY="
    SELECT conversation_id,
           COALESCE(NULLIF(title, ''), NULLIF(substr(preview, 1, 35), ''), 'Untitled'),
           strftime('%m-%d %H:%M', last_modified_time)
    FROM conversation_summaries
    WHERE (workspace_uris LIKE '%${PROJECT}%' OR project_id = '${PROJECT}' OR '${PROJECT}' = '')
    ORDER BY last_modified_time DESC
    LIMIT 35;
    "

    while IFS='|' read -r c_id c_title c_time; do
        [[ -z "$c_id" ]] && continue
        
        # If already open in a tab, skip duplicating in history list
        if [[ -n "${OPEN_TABS_BY_CONV[$c_id]:-}" ]]; then
            continue
        fi

        # Truncate title cleanly
        clean_title="${c_title//$'\n'/ }"
        clean_title="${clean_title:0:36}"
        display_line=$(printf "   [Hist]  %-36s (%s)" "$clean_title" "$c_time")
        echo "$display_line" >> "$MENU_ITEMS"
        echo "HIST	$c_id	$clean_title" >> "$DATA_MAP"
    done < <(sqlite3 "$DB_PATH" "$SQL_QUERY" 2>/dev/null || true)
fi

# 3. Present via fzf
if ! command -v fzf >/dev/null 2>&1; then
    echo "Error: fzf is required for agymux-tab-picker." >&2
    exit 1
fi

SELECTED=$(fzf --prompt="⚡ Switch Antigravity Tab: " \
               --reverse \
               --no-info \
               --header="Enter: switch/open | Esc: cancel" \
               --cycle < "$MENU_ITEMS" || true)

[[ -z "$SELECTED" ]] && exit 0

# Find line index of selected item
LINE_NUM=$(grep -n -F "$SELECTED" "$MENU_ITEMS" | head -1 | cut -d: -f1)
[[ -z "$LINE_NUM" ]] && exit 0

RECORD=$(sed -n "${LINE_NUM}p" "$DATA_MAP")
ACTION=$(echo "$RECORD" | cut -f1)
PARAM1=$(echo "$RECORD" | cut -f2)
PARAM2=$(echo "$RECORD" | cut -f3)

# 4. Execute action in tmux
case "$ACTION" in
    NEW)
        if [[ -n "${TMUX:-}" ]]; then
            tmux new-window -c "$CURRENT_DIR" -n "new-chat" "agymux-tab-runner --project '${PROJECT}'"
        else
            echo "Opening new conversation for project '${PROJECT}'..."
            agymux --project "$PROJECT" new
        fi
        ;;
    TAB)
        if [[ -n "${TMUX:-}" ]]; then
            tmux select-window -t ":$PARAM1"
        fi
        ;;
    HIST)
        conv_id="$PARAM1"
        conv_title="${PARAM2//[^a-zA-Z0-9_-]/_}"
        conv_title="${conv_title:0:15}"
        if [[ -n "${TMUX:-}" ]]; then
            tmux new-window -c "$CURRENT_DIR" -n "${conv_title:-agy}" \
                "agymux-tab-runner --project '${PROJECT}' --conversation '${conv_id}'"
        else
            echo "Resuming conversation ${conv_id}..."
            agymux --project "$PROJECT" --conversation "$conv_id"
        fi
        ;;
esac
